function correctionOfForm() {
    var inputCollections = document.querySelectorAll('input');
    inputCollections.forEach(function(inp) {
        var textLabel = inp.getAttribute('name');
        inp.insertAdjacentHTML('beforebegin', '<label for="'.concat(inp.id, '" class="field-label"></label>'));
        var label = inp.previousElementSibling;
        label.textContent = textLabel;
        inp.name = inp.name.charAt(0).toUpperCase() + inp.name.slice(1);
        inp.setAttribute('placeholder', "".concat(inp.name));
    });
}
correctionOfForm();

